{
  "name": "self-plataforma-educacional",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema Educacional de Learning e Formação - Plataforma de autoavaliação e diagnóstico",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --fix",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:e2e": "cypress run --e2e",
    "cy:run:component": "cypress run --component",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cy:test": "cypress run --component"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "@types/react-helmet": "^6.1.11",
    "firebase": "^11.4.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cypress": "^13.17.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.9"
  }
}
